<!--
  Renders the login screen with username and password fields, an
  optional error message, and a link to the registration page.
  @since 2.0.1
-->

<section class="auth"><p class="eyebrow">ACCOUNT ACCESS</p><h1>登录</h1><% if (error) { %><p class="error"><%= error %></p><% } %><form method="post" action="/login"><input name="username" required placeholder="用户名"><input name="password" required type="password" placeholder="密码"><button class="button" type="submit">进入后台</button></form><a href="/register">创建账号 →</a></section>