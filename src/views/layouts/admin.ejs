<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %> · LinearPress Admin</title><link rel="stylesheet" href="/css/admin.css?v=2.0.1"><% for (const css of pluginStyleUrls) { %><link rel="stylesheet" href="<%= css %>"><% } %></head><body><aside class="admin-side"><a class="brand" href="/">LINEARPRESS</a><p class="eyebrow">CONTROL ROOM</p><% adminMenu.forEach(item => { %><a class="nav-item" href="<%= item.link %>"><%= item.title %></a><% }) %></aside><main class="admin-main"><header class="admin-header"><span><%= title %></span><span><%= currentUser?.username %></span></header><%- body %></main><% for (const script of pluginScriptUrls) { %><script src="<%= script %>"></script><% } %></body></html>