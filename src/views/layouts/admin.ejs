<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %> · <%= siteConfig.siteName || 'LinearPress' %> Admin</title><link rel="stylesheet" href="/css/admin.css?v=2.1.0"><% for (const css of pluginStyleUrls) { %><link rel="stylesheet" href="<%= css %>"><% } %></head><body class="admin-body"><aside class="admin-side"><a class="brand" href="/"><%= siteConfig.siteName || 'LINEARPRESS' %></a><p class="eyebrow">CONTROL ROOM</p><nav class="admin-nav"><% adminMenu.forEach(item => { %><a class="nav-item<%= currentPath === item.link ? ' active' : '' %>" href="<%= item.link %>"><%= item.title %></a><% }) %></nav></aside><main class="admin-main"><header class="admin-header"><span class="admin-crumb"><%= title %></span><nav class="admin-tabs"><a class="<%= !currentPath.startsWith('/admin/settings') && currentPath !== '/admin/about' ? 'active' : '' %>" href="<%= currentPath || '/admin' %>">页面选项</a><a class="<%= currentPath.startsWith('/admin/settings') ? 'active' : '' %>" href="/admin/settings">设置</a><a class="<%= currentPath === '/admin/about' ? 'active' : '' %>" href="/admin/about">关于</a></nav><span class="admin-user"><%= currentUser?.username %></span></header><div class="admin-columns"><section class="admin-center"><%- body %></section><aside class="admin-right"><h3>详情面板</h3><div class="panel-summary"><p class="eyebrow">SITE</p><strong><%= siteConfig.siteName || 'LINEARPRESS' %></strong><p><%= siteConfig.siteDescription %></p></div><div class="panel-summary"><p class="eyebrow">MAINTENANCE</p><label class="switch-row"><span class="switch"><span class="dot <%= maintenanceEnabled ? 'on' : '' %>"></span></span><span><%= maintenanceEnabled ? '维护模式已开启' : '维护模式已关闭' %></span></label></div><% adminPanels.forEach(panel => { %><div class="panel-inject"><%- panel.html %></div><% }) %></aside></div></main><% for (const script of pluginScriptUrls) { %><script src="<%= script %>"></script><% } %></body></html>
