<div class="page-head"><h1>文章</h1><a class="button" href="/admin/posts/new">+ 新建</a></div><table><thead><tr><th>标题</th><th>状态</th><th>作者</th><th>操作</th></tr></thead><tbody><% posts.forEach(post => { %><tr><td><%= post.title %></td><td><%= post.status %></td><td><%= post.author_name %></td><td><a href="/admin/posts/<%= post.id %>/edit">编辑</a> <form class="inline" method="post" action="/admin/posts/<%= post.id %>/delete"><button>删除</button></form></td></tr><% }) %></tbody></table>