<article class="article"><p class="meta"><%= post.created_at %> / <%= post.views %> VIEWS</p><h1><%= post.title %></h1><div class="article-body"><%- html %></div></article><section class="comments"><h2>评论</h2><% if (notice) { %><p class="notice">评论已提交，等待审核。</p><% } %><% comments.forEach(comment => { %><div class="comment"><strong><%= comment.guest_name || '注册用户' %></strong><p><%= comment.content %></p></div><% }) %><form method="post" action="/post/<%= post.slug %>/comments"><input name="guest_name" placeholder="姓名"><input name="guest_email" type="email" placeholder="邮箱"><textarea name="content" required placeholder="写下你的评论"></textarea><button class="button" type="submit">提交评论</button></form></section>