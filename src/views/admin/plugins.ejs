<div class="page-head"><h1>插件</h1><p class="eyebrow">拖动条目调整加载顺序</p></div><ol class="plugin-list" id="plugin-list"><% plugins.forEach(plugin => { %><li draggable="true" data-plugin-id="<%= plugin.id %>"><span class="drag-handle">::</span><div class="plugin-info"><strong><%= plugin.name %></strong><small><%= plugin.id %> / v<%= plugin.version %> / order <%= plugin.load_order %></small></div><span class="plugin-status"><%= plugin.enabled ? '启用' : '停用' %></span><form method="post" action="/admin/plugins/<%= plugin.id %>/toggle"><button><%= plugin.enabled ? '停用' : '启用' %></button></form><% if (plugin.id !== 'seo') { %><form method="post" action="/admin/plugins/<%= plugin.id %>/uninstall" onsubmit="return confirm('卸载将删除插件目录，继续吗？')"><button>卸载</button></form><% } %></li><% }) %></ol><p id="sort-status" class="notice" hidden>顺序已保存。</p><script src="/js/plugin-sort.js"></script>