<!--
  Renders the OOBE wizard shown on first run: a welcome screen
  introducing the plugin-based architecture, creation of the unique
  super-admin account, site information setup, and a final
  confirmation step leading into the admin console.
  @since 2.0.1
-->

<section class="auth oobe">
  <p class="eyebrow">FIRST RUN / OOBE · STEP <%= step %> / 4</p>
  <% if (step === 1) { %>
    <h1>欢迎来到 LinearPress <%= LINEARPRESS_VERSION %>！</h1>
    <p class="lede">感谢您安装 LinearPress，让我们简单地开始设置流程吧。</p>
    <div class="oobe-card">
      <p class="eyebrow">ABOUT PLUGINS</p>
      <p><strong>关于插件</strong>：LinearPress 基于 Cordis，践行“一切皆插件”的设计理念。您可以通过下载插件来实现高级功能，也可以参阅 <a href="#">文档链接</a> 来开发一个自己的插件。</p>
    </div>
    <form method="post" action="/oobe"><input type="hidden" name="step" value="1"><button class="button" type="submit">下一步 →</button></form>
  <% } else if (step === 2) { %>
    <h1>创建管理员账户</h1>
    <p class="lede">此账号是全站唯一的超级管理员，始终拥有全部权限。创建后无法通过注册流程增加第二个超级管理员。</p>
    <% if (error) { %><p class="error"><%= error %></p><% } %>
    <form method="post" action="/oobe"><input type="hidden" name="step" value="2"><label>用户名<input name="username" required minlength="3" autocomplete="username" placeholder="站点管理员"></label><label>邮箱<input name="email" required type="email" autocomplete="email" placeholder="admin@example.com"></label><label>密码<input name="password" required minlength="8" type="password" autocomplete="new-password" placeholder="至少 8 位"></label><label>确认密码<input name="password_confirmation" required minlength="8" type="password" autocomplete="new-password" placeholder="再次输入密码"></label><button class="button" type="submit">下一步 →</button></form>
  <% } else if (step === 3) { %>
    <h1>设置站点信息</h1>
    <p class="lede">这些信息将展示在站点首页与控制面板左上角，之后可在「站点设置」中修改。</p>
    <% if (error) { %><p class="error"><%= error %></p><% } %>
    <form method="post" action="/oobe"><input type="hidden" name="step" value="3"><label>站点名称<input name="siteName" value="<%= config.siteName %>" placeholder="LinearPress"></label><label>站点标题<input name="siteTitle" value="<%= config.siteTitle %>" placeholder="写下值得留下的内容。"></label><label>站点副标题<input name="siteSubtitle" value="<%= config.siteSubtitle %>" placeholder="极简、可扩展的写作空间。"></label><label>站点介绍<textarea name="siteDescription" placeholder="A focused publishing system."><%= config.siteDescription %></textarea></label><button class="button" type="submit">下一步 →</button></form>
  <% } else { %>
    <h1>配置完成</h1>
    <p class="lede">LinearPress 已准备就绪。您可以进入控制台开始写作，或先回到首页看看。</p>
    <div class="oobe-card"><p>站点名称：<strong><%= config.siteName %></strong></p><p>管理账号已创建，站点信息已保存。</p></div>
    <form method="post" action="/oobe"><input type="hidden" name="step" value="4"><button class="button" type="submit">进入控制台 →</button></form>
  <% } %>
</section>
