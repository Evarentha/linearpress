{
  "name": "linearpress",
  "version": "3.0.0",
  "description": "A server-rendered blogging system powered by TypeScript, Express 5, EJS and SQLite with a Cordis plugin architecture.",
  "type": "module",
  "main": "index.ts",
  "files": [
    "index.ts",
    "src/core",
    "src/controllers",
    "src/services",
    "src/types",
    "src/public",
    "src/views",
    "src/plugins/seo",
    "src/plugins/minimal-theme",
    "scripts",
    "config",
    "docs",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "dev": "node scripts/serve.js",
    "start": "node scripts/serve.js",
    "start:direct": "node scripts/run.js index.ts",
    "plugin:pack": "node scripts/run.js scripts/pack-plugin.ts",
    "test:lpp": "node scripts/run.js scripts/lpp-boundary-check.ts",
    "db:init": "node scripts/run.js scripts/init-db.ts",
    "seed": "node scripts/run.js scripts/seed.ts",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "test": "node scripts/run.js scripts/smoke.ts",
    "sync": "sh scripts/sync-plugins.sh",
    "prepublishOnly": "npm run typecheck"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "blog",
    "cms",
    "server-rendered",
    "typescript",
    "express",
    "ejs",
    "sqlite",
    "cordis",
    "plugin",
    "linearpress",
    "evarentha"
  ],
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "adm-zip": "^0.6.0",
    "bcryptjs": "^2.4.3",
    "cordis": "^4.0.0-rc.8",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-ejs-layouts": "^2.5.1",
    "express-session": "^1.18.1",
    "fs-extra": "^11.3.0",
    "lodash-es": "^4.17.21",
    "mysql2": "^3.23.4",
    "tar": "^7.5.22",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.18.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.15.21",
    "@types/tar": "^6.1.13"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Evarentha/linearpress.git"
  },
  "homepage": "https://github.com/Evarentha/linearpress#readme",
  "bugs": {
    "url": "https://github.com/Evarentha/linearpress/issues"
  },
  "author": "MoyuZJ <moyuzj@moyuzj.cn> (https://moyuzj.cn)"
}
