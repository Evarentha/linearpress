<!--
  Theme-specific template for the public post page. Renders the
  article with a MINIMAL THEME metadata line and an English
  comments section with a guest response form.
  @since 2.0.1
-->

<article class="article article-theme"><p class="meta">MINIMAL THEME / <%= formatDate(post.created_at) %></p><h1><%= post.title %></h1><div class="article-body"><%- html %></div></article><section class="comments"><h2>Responses</h2><% comments.forEach(comment => { %><div class="comment"><strong><%= comment.guest_name || 'Reader' %></strong><p><%= comment.content %></p></div><% }) %><form method="post" action="<%= postUrl(post) %>/comments"><input name="guest_name" placeholder="Name"><textarea name="content" required placeholder="Leave a response"></textarea><button class="button" type="submit">Send</button></form></section>
