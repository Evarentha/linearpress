<!--
  Layout template for admin pages. Renders the document head with
  the admin stylesheet and plugin styles, the sidebar navigation
  with collapsible menu groups and a mobile burger drawer, the page
  header, the center content column with the right details panel,
  and plugin scripts.
  @since 2.0.1
-->

<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %> · <%= siteConfig.siteName || 'LinearPress' %> Admin</title><link rel="stylesheet" href="/css/admin.css?v=2.1.0"><% for (const css of pluginStyleUrls) { %><link rel="stylesheet" href="<%= css %>"><% } %></head><body class="admin-body"><button type="button" class="admin-burger" id="adminBurger" aria-label="打开导航菜单" aria-expanded="false"><span></span><span></span><span></span></button><aside class="admin-side"><a class="brand" href="/"><%= siteConfig.siteName || 'LINEARPRESS' %></a><p class="eyebrow">CONTROL ROOM</p><nav class="admin-nav"><% adminMenu.forEach(item => { if (item.children && item.children.length) { %><div class="admin-nav-group" data-admin-group><a class="nav-item<%= item.children.some(c => currentPath === c.link || (item.link && currentPath === item.link)) ? ' active' : '' %> admin-nav-parent" href="<%= item.link %>"><%= item.title %><span class="admin-nav-caret">▾</span></a><div class="admin-nav-children<%= item.children.some(c => currentPath === c.link) ? ' is-open' : '' %>"><% item.children.forEach(child => { %><a class="nav-item admin-nav-child<%= currentPath === child.link ? ' active' : '' %>" href="<%= child.link %>"><%= child.title %></a><% }) %></div></div><% } else { %><a class="nav-item<%= currentPath === item.link ? ' active' : '' %>" href="<%= item.link %>"><%= item.title %></a><% } }) %></nav></aside><main class="admin-main"><header class="admin-header"><span class="admin-crumb"><%= title %></span><span class="admin-user"><%= currentUser?.username %></span></header><div class="admin-columns"><section class="admin-center"><%- body %></section><aside class="admin-right"><h3>详情面板</h3><div class="panel-summary"><p class="eyebrow">SITE</p><strong><%= siteConfig.siteName || 'LINEARPRESS' %></strong><p><%= siteConfig.siteDescription %></p></div><div class="panel-summary"><p class="eyebrow">MAINTENANCE</p><label class="switch-row"><span class="switch"><span class="dot <%= maintenanceEnabled ? 'on' : '' %>"></span></span><span><%= maintenanceEnabled ? '维护模式已开启' : '维护模式已关闭' %></span></label></div><% adminPanels.forEach(panel => { %><div class="panel-inject"><%- panel.html %></div><% }) %></aside></div></main><div class="admin-overlay" id="adminOverlay" data-open="false"></div><script>(function(){var burger=document.getElementById('adminBurger'),drawer=document.querySelector('.admin-side'),overlay=document.getElementById('adminOverlay');if(!burger||!drawer||!overlay)return;function setOpen(open){drawer.classList.toggle('admin-side-open',open);overlay.setAttribute('data-open',open?'true':'false');burger.setAttribute('aria-expanded',String(open));burger.setAttribute('aria-label',open?'收起导航菜单':'打开导航菜单');}burger.addEventListener('click',function(e){e.stopPropagation();setOpen(!drawer.classList.contains('admin-side-open'));});overlay.addEventListener('click',function(){setOpen(false);});drawer.addEventListener('click',function(e){if(e.target.closest('a'))setOpen(false);});document.addEventListener('keydown',function(e){if(e.key==='Escape')setOpen(false);});document.querySelectorAll('[data-admin-group]').forEach(function(group){var children=group.querySelector('.admin-nav-children'),parent=group.querySelector('.admin-nav-parent');if(!children||!parent)return;parent.addEventListener('click',function(e){e.preventDefault();e.stopPropagation();children.classList.toggle('is-open');});});})();</script><% for (const script of pluginScriptUrls) { %><script src="<%= script %>"></script><% } %></body></html>
