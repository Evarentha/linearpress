<div class="page-head"><h1>插件</h1><p class="eyebrow">拖动条目调整加载顺序</p></div>
<section class="plugin-install">
  <h2>安装插件</h2>
  <form id="npm-install-form">
    <input type="text" id="npm-package-name" placeholder="npm 包名（如 linearpress-plugin-name 或 name@1.0.0）" autocomplete="off" required>
    <button type="submit" class="button">从 npm 安装</button>
  </form>
  <form id="zip-install-form">
    <input type="file" id="zip-file" accept=".zip,application/zip,application/x-zip-compressed" required>
    <button type="submit" class="button">上传 ZIP 安装</button>
  </form>
  <p id="install-status" class="notice" hidden></p>
</section>
<ol class="plugin-list" id="plugin-list"><% plugins.forEach(plugin => { %><li draggable="true" data-plugin-id="<%= plugin.id %>"><span class="drag-handle">::</span><div class="plugin-info"><strong><%= plugin.name %></strong><small><%= plugin.id %> / v<%= plugin.version %> / order <%= plugin.load_order %></small></div><span class="plugin-status"><%= plugin.enabled ? '启用' : '停用' %></span><% if (plugin.id === 'mysql-plugin') { %><a class="plugin-settings-link" href="/admin/plugins/mysql-plugin/settings">插件设置</a><% } %><form method="post" action="/admin/plugins/<%= plugin.id %>/toggle"><button><%= plugin.enabled ? '停用' : '启用' %></button></form><% if (!builtinPlugins.includes(plugin.id)) { %><form method="post" action="/admin/plugins/<%= plugin.id %>/uninstall" onsubmit="return confirm('卸载将删除插件目录，继续吗？')"><button>卸载</button></form><% } %></li><% }) %></ol><p id="sort-status" class="notice" hidden>顺序已保存。</p>
<script src="/js/plugin-sort.js"></script>
<script src="/js/plugin-install.js"></script>