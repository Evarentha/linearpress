<div class="page-head"><h1>权限组</h1></div><section class="group-grid"><% groups.forEach(group => { %><article class="group-panel"><div class="group-heading"><div><p class="eyebrow"><%= group.is_system ? 'SYSTEM GROUP' : 'CUSTOM GROUP' %></p><h2><%= group.name %></h2></div><% if (!group.is_system) { %><form method="post" action="/admin/groups/<%= group.id %>/delete"><button onclick="return confirm('删除后该组用户会转入 subscriber，继续吗？')">删除</button></form><% } %></div><form method="post" action="/admin/groups/save"><input type="hidden" name="id" value="<%= group.id %>"><input name="name" value="<%= group.name %>" <%= group.is_system ? 'disabled' : '' %>><div class="permission-grid"><% permissions.forEach(permission => { %><label><input type="checkbox" name="permissions" value="<%= permission %>" <%= group.permissions.includes(permission) || group.permissions.includes('*') ? 'checked' : '' %> <%= group.is_system ? 'disabled' : '' %>><span><%= permission %></span></label><% }) %></div><% if (!group.is_system) { %><button class="button" type="submit">保存权限</button><% } %></form></article><% }) %></section><section class="group-panel new-group"><p class="eyebrow">NEW ROLE</p><h2>创建权限组</h2><form method="post" action="/admin/groups/save"><input name="name" required placeholder="例如 reviewer"><div class="permission-grid"><% permissions.forEach(permission => { %><label><input type="checkbox" name="permissions" value="<%= permission %>"><span><%= permission %></span></label><% }) %></div><button class="button" type="submit">创建权限组</button></form></section>