<article class="article article-theme"><p class="meta">MINIMAL THEME / <%= formatDate(post.created_at) %></p><h1><%= post.title %></h1><div class="article-body"><%- html %></div></article>
<% if (typeof advancedCommentsPartial === 'string' && advancedCommentsPartial) { %>
  <%- include(advancedCommentsPartial) %>
<% } else { %>
<section class="comments"><h2>Responses</h2>
  <% if (typeof acCommentError === 'string' && acCommentError) { %><p class="notice" role="alert"><%= acCommentError %></p><% } %>
  <% if (typeof notice !== 'undefined' && notice) { %><p class="notice">评论已提交，等待审核。</p><% } %>
  <% comments.forEach(comment => { %><div class="comment"><strong><%= comment.guest_name || 'Reader' %></strong><p><%= comment.content %></p></div><% }) %>
  <form method="post" action="<%= postUrl(post) %>/comments">
    <% if (typeof currentUser !== 'undefined' && currentUser) { %><p>以 <strong><%= currentUser.username %></strong> 身份评论。</p>
    <% } else { %><input name="guest_name" required placeholder="Name"><input name="guest_email" type="email" placeholder="Email (optional)"><% } %>
    <textarea name="content" required placeholder="Leave a response"></textarea><button class="button" type="submit">Send</button>
  </form>
</section>
<% } %>
