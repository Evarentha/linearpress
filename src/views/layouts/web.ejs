<!doctype html><html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= title %> · <%= siteConfig.title %></title><link rel="stylesheet" href="/css/style.css"><% for (const css of pluginStyleUrls) { %><link rel="stylesheet" href="<%= css %>"><% } %><script src="https://cdn.tailwindcss.com"></script></head><body><header class="site-header"><a class="brand" href="/">LINEARPRESS</a><nav><a href="/">首页</a><% if (currentUser) { %><a href="/admin">后台</a><form action="/logout" method="post"><button>退出</button></form><% } else { %><a href="/login">登录</a><% } %></nav></header><main class="shell"><%- body %></main><footer class="site-footer">TYPE-SAFE PUBLISHING / <%= new Date().getFullYear() %></footer><% for (const script of pluginScriptUrls) { %><script src="<%= script %>"></script><% } %></body></html>